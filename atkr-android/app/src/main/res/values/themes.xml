<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Hint">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Toggle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:thumbTint">@android:color/white</item>
        <item name="android:trackTint">@color/toggle_track</item>
        <item name="android:trackTintMode">src_over</item>
        <item name="android:switchPadding">8dp</item>
    </style>

    <style name="BaseButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">20dp</item>
    </style>

    <style name="PrimaryButton" parent="BaseButton">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
    </style>

    <style name="SecondaryButton" parent="BaseButton">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/button_secondary_text</item>
    </style>
</resources>
